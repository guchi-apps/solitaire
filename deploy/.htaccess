# Static Solitaire site — disable directory listing and block dotfiles.
Options -Indexes
DirectoryIndex index.html

AddType image/svg+xml .svg
AddType image/png .png
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest

<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^\.">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|png|ico|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # JSモジュールはimportにバージョンが付かない（./settings.js 等）ため、長期キャッシュすると
  # デプロイ直後に新しいgame.jsと古い子モジュールが混ざって読み込みに失敗する（#130）。
  # ETagで毎回再検証させる。
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
